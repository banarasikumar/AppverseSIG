# Canonical public URL used for OpenGraph metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://appverse.si

# Optional webhook endpoint (Slack, Discord, Make, Zapier, or custom API)
# When set, POST /api/contact forwards validated project enquiries in real time.
CONTACT_WEBHOOK_URL=

# Optional Resend API key (https://resend.com) for direct email delivery from /api/contact
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=

# Optional public contact email shown in the mailto fallback if no server webhook is configured
NEXT_PUBLIC_CONTACT_EMAIL=
